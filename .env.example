# ─────────────────────────────────────────────────────────────
# TRACE-X Environment Configuration
# Copy to .env and adjust values for your environment
# ─────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
DB_NAME=trace_x

# ── Application Mode ────────────────────────────────────────
# DEMO_MODE=true → all connectors return synthetic data
# Set to false only when real connectors are implemented (Phase 3+)
DEMO_MODE=true

# ── Data Retention (Privacy) ────────────────────────────────
# Investigations auto-delete after this many days (TTL index)
RETENTION_DAYS=30

# ── ML Weights (must sum ≈ 1.0; auto-normalized at startup) ─
NAME_WEIGHT=0.35
BIO_WEIGHT=0.25
CROSS_PLATFORM_WEIGHT=0.25
EVIDENCE_WEIGHT=0.10
CONFLICT_PENALTY=0.05

# ── Bayesian Prior ──────────────────────────────────────────
# P(same_person) prior probability
PRIOR_SAME_PERSON=0.3

# ── Application ─────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Auth (Phase 3+ placeholder) ─────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
